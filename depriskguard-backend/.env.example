# Which LLM backend to use: "anthropic", "openai" or "nebius"
LLM_PROVIDER=nebius

# --- If LLM_PROVIDER=anthropic ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- If LLM_PROVIDER=openai ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any chat model your account can reach, e.g. gpt-4o, gpt-4.1, gpt-4o-mini.
# Reasoning models (o3, o4-mini, gpt-5...) work too, but see the README note:
# their reasoning tokens count against max_tokens and can starve the answer.
OPENAI_MODEL=gpt-4o
# Optional: an OpenAI-compatible gateway or proxy. Leave blank for api.openai.com
OPENAI_BASE_URL=

# --- If LLM_PROVIDER=nebius ---
# Get a key at https://studio.nebius.ai (Nebius AI Studio / Token Factory).
# NEBIUS_MODEL must be a model you have enabled, exactly as Nebius names it,
# e.g. Qwen/Qwen3-235B-A22B or meta-llama/Llama-3.3-70B-Instruct
NEBIUS_API_KEY=
NEBIUS_MODEL=
# Override if Nebius moves the host (they are rebranding to "Token Factory")
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/

# --- Optional, all providers ---
# Seconds before a single LLM request is abandoned. Without this a stalled
# provider would hang /analyze indefinitely rather than returning an error.
LLM_TIMEOUT_SECONDS=120

# Raises GitHub API rate limits from ~60/hr to 5000/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=
